  def set_sequence(*buttons)
    trigger_last_clear
    buttons = buttons.flatten
    @button_target_names = buttons.map(&:to_s)
    @button_targets = buttons.map {|b| BUTTON_CODES[b] }
    @button_sequence_names = []
    @button_sequence = []
    @sequence_max = @button_targets.size
    @store_sequence = true
  end

  def set_sequence_timer(n, *buttons)
    set_sequence(*buttons)
    n *= Graphics.frame_rate
    @sequence_timer = n.to_i
    @start_sequence_timer = true
  end

  def clear_button_sequence
    @button_sequence.clear
    @button_targets.clear
    @button_target_names.clear
    @button_sequence_names.clear
    @sequence_max = 0
  end

  def same_sequence?
    @button_targets == @button_sequence
  end

  def update
    update_internal
    update_button_sequence
    update_gamepad_state
  rescue => e
    puts e.full_message
  end

  private
  def update_button_sequence
    2.times do |n|
      next unless @store_sequence[n]
      button = trigger_last(n)
      if button > 0
        trigger_last_clear(n)
        @button_sequence[n] << button
        @button_sequence_names[n] << CODE_BUTTONS[button]
      end
      if @start_sequence_timer[n]
        @sequence_timer[n] -= 1
        @store_sequence[n] = @sequence_timer[n] > 0
        @start_sequence_timer[n] = !@store_sequence[n]
        return
      elsif @button_sequence[n].size == @sequence_max[n]
        @sequence_timer[n] = 0
        @store_sequence[n] = false
      end
    end
  end

  def update_gamepad_state
    if trigger?(:F1) and !Graphics.block_f1
      Sound.play_ok
      KChangeKeys.open!
      return
    end
    state = gamepad_change?
    return if state == 0
    @gamepad_updates.pop
    case state
    when 2
      @gamepad_updates << :add
      setup_gamepad
    when 1
      @gamepad_updates << :remove
      reset_gamepad
    end
  rescue => e
    puts e.full_message
  end

  def save_new_bindings(pos)
    if pos == :key
      save_bindings(pos, KEYBOARD_GENERIC)
    else
      save_bindings(pos, @gamepads[pos].internal_name)
    end
  end

  def setup_gamepad(n=nil)
    n ||= gamepad_index
    list = gamepad_basic_values(n)
    list << true
    @gamepads[n] = Gamepad.new(n, *list)
    if @temp_binding
      parse_preset_gamepad_bindings(n)
    end
    reset_bindings(n)
  end

  def reset_gamepad
    n = gamepad_index
    name = Gamepad::DEFAULT_NAME
    @gamepads[n] = Gamepad.new(n, name, 0, 0, -1, false, false)
    reset_bindings(n)
  end

  def reset_bindings(pos)
    pass = true
    code = @gamepads[pos].internal_name.to_sym
    @bindings[pos] = @all_bindings[code]
    if code&.empty?
      puts "Empty Gamepad Code!"
      pass = false
    elsif pass and !@bindings[pos]
      puts "No #{code} Bindings found!"
      pass = false
    end
    reset_sdl_bindings(pos) if pass
  rescue => e
    puts "Reset Key Bindings"
    puts e.full_message
  end

  def process_target_button(line)
    line.sub!(/(\w+)\s?=\s?/i, "")
    $1
  end

  def parse_preset_keyboard_bindings
    code = KEYBOARD_GENERIC.to_sym
    @bindings[:key] = KeyBindings.new
    lines = PRESET_BINDINGS.dup
    parse_bindings_lines(@bindings[:key], lines)
    @all_bindings[code] = @bindings[:key]
    save_bindings(:key, code.to_s)
  end

  def parse_preset_gamepad_bindings(pos)
    gp = @gamepads[pos]
    name = gp.vendor_fn.downcase
    code = gp.internal_name.to_sym
    @bindings[pos] = KeyBindings.new
    lines = PRESET_GAMEPAD_BINDINGS[name] || PRESET_BINDINGS
    lines = lines.dup
    parse_bindings_lines(@bindings[pos], lines)
    @all_bindings[code] = @bindings[pos]
    save_bindings(pos, code)
    @temp_binding = nil
  end

  def parse_bindings(fn, code)
    lines = File.readlines(fn)
    heading = lines.shift
    unless heading[/header/i]
      parsing_kb_error(code, "missing [Header]")
      return
    end
    name = lines.shift.chomp
    bind = KeyBindings.new
    bind.name = name.sub(/name\s?(=)\s?/i, "")
    bind.code = code
    unless $1
      parsing_kb_error(code, "missing = operator in line #{2}")
      return
    end
    bind.version = Game::RGSS_VERSION
    heading = lines.shift
    unless heading[/bindings/i]
      parsing_kb_error(code, "missing [Bindings]")
      return
    end
    parse_bindings_lines(bind, lines)
    @all_bindings[code.to_sym] = bind
  end

  def parse_bindings_lines(bind, lines)
    slot_max = 4
    14.times do |n|
      line = lines.shift.sub(/\w+\s?(=)\s?/i, "")
      group = bind.list[n]
      group.target = n
      names = line.split(",")
      names = names.take(slot_max)
      names << "" while names.size < slot_max
      slot_max.times do |n|
        b = group[n]
        b.index = n
        b.name = names[n]
      end
    end
  end

  def parsing_kb_error(code, reason)
    puts "Failed to parse #{code}.ini, reason: #{reason}."
  end

  def load_all_bindings(files)
    files.each do |fn|
      code = File.basename(fn, "." + Game.data_ext)
      load_bindings(code)
    end
  end

  def save_bindings(pos, code)
    file = Game.bindings_path(code)
    sym = code.to_sym
    if @all_bindings.key?(sym)
      binds = @all_bindings[sym]
    else
      binds = @bindings[pos] || KeyBindings.new
      @all_bindings[sym] = binds
    end
    binds.update_active
    Game.save_data(file, binds)
  end

  def load_bindings(code)
    file = Game.bindings_path(code)
    @all_bindings[code.to_sym] = Game.load_data(file)
  end
end

