  def switch_gamepads!
    n = total_gamepads
    return if n == 0
    return if n == 1 and @gamepads[1].default_name?
    switch_gamepads
    list = [@bindings[1], @bindings[0]]
    @bindings[0] = list.shift
    @bindings[1] = list.shift
    @gamepads.reverse!
    2.times {|n| @gamepads[n].id = n }
  end

