module Graphics
  def self.play_movie(fn, vol=100, resized=false, skip=true)
    path = Game.movie_path
    if Game::RGSS_VERSION != 3 and !fn.include?(path)
      fn = path + fn
    end
    if !fn.include?(".ogv")
      fn += ".ogv"
    end
    if !File.exist?(fn)
      print "Failed to open file #{fn}!\n",
            "File does not exist!"
      return false
    end
    @movie = Movie.new(fn, vol, skip, resized)
    prepare_movie
    if @movie.failed
      @movie = nil
      print "Failed to play videoclip #{fn}!"
      return false
    end
    mw = @movie.width
    mh = @movie.height
    w, h = dimensions
    old_fps = frame_rate
    self.frame_rate = @movie.fps
    backdrop = Sprite.new
    backdrop.z = 10001
    change_resolution = false
    if resized and !fullscreen
      if @movie.width != w or @movie.height != h
        resize_screen(mw, mh, true)
        change_resolution = true
      end
      bw, bh = mw, mh
    else
      bw, bh = w, h
    end
    bitmap = Bitmap.new(bw, bh)
    bitmap.fill_rect(0, 0, bw, bh, Color.new(0, 0, 0, 255))
    backdrop.bitmap = bitmap
    Audio.bgm_pause
    Audio.bgs_pause
    update
    play_movie_int
    update
    Audio.bgm_resume
    Audio.bgs_resume
    self.frame_rate = old_fps
    if change_resolution
      resize_screen(w, h, true)
    end
    backdrop.bitmap.dispose
    backdrop.dispose
    self.frame_rate = old_fps
    @movie = nil
    true
  end
end

