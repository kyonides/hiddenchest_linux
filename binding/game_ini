  end

  class AllBindings
    def initialize
      @data = {}
    end

    def [](code)
      @data[code]
    end

    def []=(code, bindings)
      @data[code] = bindings
    end

    def codes
      @data.map {|k,v| v.code }
    end

    def default?
      @data.keys == [KEYBOARD_GENERIC.to_sym]
    end

    def empty?
      @data.empty?
    end

    def key?(code)
      @data.key?(code)
    end
  end

