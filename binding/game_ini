  def load_init_bindings
    @all_bindings = AllBindings.new
    ext = Game.data_ext
    files = Dir[Game.glob_kb].sort
    if files.any?
      load_all_bindings(files)
    end
    codes = @all_bindings.codes
    files = Dir[Game.glob_init_kb].sort
    files.each do |file|
      code = File.basename(file, "." + ext)
      next if codes.include?(code)
      fn = "#{code}.#{ext}"
      FileUtils.mv(file, Game.bindings_path(code))
      load_bindings(code)
      codes << code
    end
    inis = Dir["Input/*.ini"].sort
    if inis.any?
      inis.each_with_index do |fn, n|
        code = File.basename(fn, ".ini")
        next if codes.include?(code)
        parse_bindings(fn, code)
        pos = code[/key/i] ? :key : nil
        save_bindings(pos, code)
      end
    end
    if @all_bindings.empty?
      parse_preset_keyboard_bindings
    end
    init_gamepads
  end

  def init_gamepads
    if gamepad?
      @gamepad_updates << :add
      @temp_binding = @all_bindings.default?
      total = total_gamepads
      puts "Found #{total} Gamepads"
      total.times do |n|
        setup_gamepad(n)
        gamepad_change!
        update
      end
    else
      @gamepad_updates << :remove
      puts "Could not find any gamepad!"
      reset_gamepad
    end
  end

